# worker (Railway). Never commit a filled-in copy.
SUPABASE_URL=
# Public key, handed to the dashboard at load time via /config.js.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Stripe is optional. Leave these blank (or as placeholders) and billing is off:
# everyone stays in the free preview. A value only counts with Stripe's real
# prefix (sk_/rk_, whsec_, price_).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
TRIAL_DAYS=7
# This service's public address. On Railway it defaults to the generated
# domain, so leave it unset unless you add a custom domain.
WEB_URL=
PORT=

# Encrypts the WhatsApp logins stored in wa_auth. 64 hex characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing it means every customer has to link WhatsApp again.
WA_AUTH_ENCRYPTION_KEY=

# Set only while rotating the key above, and accepted for decryption only.
# To rotate without logging anybody out: put the current key here, the new key
# above, deploy, wait for every session to reconnect, then remove this line.
# WA_AUTH_ENCRYPTION_KEY_PREVIOUS=

# How long a past_due or unpaid subscription keeps saving while Stripe retries
# the card. 0 stops the moment the payment fails.
PAYMENT_GRACE_HOURS=72

# Activity rows older than this are swept nightly. 0 keeps them forever, which
# grows without limit — every new person who messages writes a row.
EVENT_RETENTION_DAYS=90

# How many days an unsubscribed account may run the free preview before its
# WhatsApp socket is closed. 0 is no limit, which is the default: an expiring
# preview is a worse demonstration. Every free account holds a socket though,
# and that is the real per-customer cost, so set this when it starts to matter.
FREE_PREVIEW_DAYS=0

# Optional: emails the customer when WhatsApp logs them out (resend.com).
# EMAIL_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Product name used in that email.
APP_NAME=SaveBot

# Who may see the admin page, comma separated. Matched against the email in the
# verified Supabase JWT, ignoring case. Empty means nobody, which is the
# default — an admin page open by accident is worse than no admin page.
ADMIN_EMAILS=

# Sharding. Leave both unset for one worker that owns every customer.
# To scale past one worker, run N separate Railway services from this repo —
# NOT one service with more replicas. Give every service the same
# REPLICA_COUNT=N and each its own REPLICA_INDEX, 0 to N-1. See the README.
# REPLICA_INDEX=0
# REPLICA_COUNT=1

# How often a worker brings its sockets in line with what customers asked for.
# Requests also nudge a reconcile straight away, so this is only the fallback.
RECONCILE_SECONDS=15
