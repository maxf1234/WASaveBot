# worker (Railway). Never commit a filled-in copy.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
TRIAL_DAYS=7
WEB_URL=
PORT=

# Encrypts the WhatsApp logins stored in wa_auth. 64 hex characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing or changing it means every customer has to link WhatsApp again.
WA_AUTH_ENCRYPTION_KEY=

# Optional: emails the customer when WhatsApp logs them out (resend.com).
# EMAIL_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Product name used in that email.
APP_NAME=SaveBot
